@startuml
left to right direction
skinparam defaultFontName Arial
skinparam packageStyle rectangle
actor "Посетитель" as Visitor
actor "Автор отзывов" as Author
actor "Редактор каталога" as Editor
actor "Модератор" as Moderator
actor "Администратор" as Admin
actor "Картографический сервис" as Maps
actor "Источник внешних оценок" as Source
Author --|> Visitor
rectangle "Агрегатор оценок шавермы в Санкт-Петербурге" {
  usecase "UC-01\nНайти и выбрать заведение" as UC01
  usecase "UC-11\nОпределить точку поиска" as UC11
  usecase "UC-02\nПросмотреть карточку" as UC02
  usecase "UC-14\nЗарегистрироваться" as UC14
  usecase "UC-07\nСообщить об ошибке" as UC07
  usecase "UC-06\nПолучить маршрут" as UC06
  usecase "UC-15\nВойти в систему" as UC15
  usecase "UC-03\nОтправить оценку и отзыв" as UC03
  usecase "UC-12\nПроверить данные отзыва" as UC12
  usecase "UC-05\nПроверить свой отзыв" as UC05
  usecase "UC-04\nРассмотреть отзыв" as UC04
  usecase "UC-13\nЗафиксировать решение" as UC13
  usecase "UC-08\nВести каталог" as UC08
  usecase "UC-09\nОбновить внешние оценки" as UC09
  usecase "UC-10\nУправлять ролями" as UC10
}
Visitor -- UC01
Visitor -- UC02
Visitor -- UC14
Visitor -- UC15
Visitor -- UC06
Author -- UC03
Author -- UC05
Editor -- UC08
Editor -- UC09
Maps -- UC11
Maps -- UC06
Source -- UC09
Moderator -- UC04
Admin -- UC10
UC01 ..> UC11 : <<include>>
UC01 ..> UC02 : <<include>>
UC03 ..> UC12 : <<include>>
UC04 ..> UC13 : <<include>>
UC06 ..> UC02 : <<extend>>\nпо запросу маршрута
UC07 ..> UC02 : <<extend>>\nпри обнаружении ошибки
@enduml
