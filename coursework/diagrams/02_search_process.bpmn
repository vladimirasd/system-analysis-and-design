<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Search" targetNamespace="https://example.org/shawarma/requirements">
  <bpmn:collaboration id="Collaboration_Search">
    <bpmn:participant id="PoolUser" name="Посетитель" processRef="Process_User" />
    <bpmn:participant id="PoolSystem" name="Агрегатор" processRef="Process_System" />
    <bpmn:participant id="PoolMaps" name="Картографический сервис" />
    <bpmn:messageFlow id="M1" name="Поиск" sourceRef="USearch" targetRef="SSearchStart" />
    <bpmn:messageFlow id="M2" name="Результат" sourceRef="SReply" targetRef="UResults" />
    <bpmn:messageFlow id="M3" name="Карточка" sourceRef="UChoose" targetRef="SCardStart" />
    <bpmn:messageFlow id="M4" name="Ответ" sourceRef="SCardReply" targetRef="UCard" />
    <bpmn:messageFlow id="M5" name="Маршрут" sourceRef="URouteReq" targetRef="SRouteStart" />
    <bpmn:messageFlow id="M6" name="Результат" sourceRef="SRouteReply" targetRef="URoute" />
    <bpmn:messageFlow id="M7" name="Адрес → координаты" sourceRef="SSearch" targetRef="PoolMaps" />
    <bpmn:messageFlow id="M8" name="Координаты / отказ" sourceRef="PoolMaps" targetRef="SSearch" />
    <bpmn:messageFlow id="M9" name="Точки → маршрут" sourceRef="SRoute" targetRef="PoolMaps" />
    <bpmn:messageFlow id="M10" name="Маршрут / отказ" sourceRef="PoolMaps" targetRef="SRoute" />
  </bpmn:collaboration>
  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:startEvent id="UStart" name="Выбор">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="USearch" name="Задать точку и фильтры; отправить запрос">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="UResults" name="Ответ поиска">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:messageEventDefinition id="UResults_MessageDefinition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="UFound" name="Получен список точек?" gatewayDirection="Diverging">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UChoose" name="Выбрать заведение; запросить карточку">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="UCard" name="Ответ карточки">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:messageEventDefinition id="UCard_MessageDefinition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="UCardOK" name="Карточка доступна?" gatewayDirection="Diverging">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="URouteNeeded" name="Нужен маршрут?" gatewayDirection="Diverging">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="URouteReq" name="Запросить маршрут от точки поиска">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="URoute" name="Маршрут или причина отказа">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:messageEventDefinition id="URoute_MessageDefinition" />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="UMerge" name="" gatewayDirection="Converging">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="UEnd" name="Заведение выбрано, адрес получен">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="URetry" name="Продолжить поиск?" gatewayDirection="Mixed">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="UCancel" name="Поиск прекращён">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="UStart" targetRef="USearch" />
    <bpmn:sequenceFlow id="F2" sourceRef="USearch" targetRef="UResults" />
    <bpmn:sequenceFlow id="F3" sourceRef="UResults" targetRef="UFound" />
    <bpmn:sequenceFlow id="F4" sourceRef="UFound" targetRef="UChoose" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F5" sourceRef="UFound" targetRef="URetry" name="Нет / ошибка">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет / ошибка</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F6" sourceRef="URetry" targetRef="USearch" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F7" sourceRef="URetry" targetRef="UCancel" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F8" sourceRef="UChoose" targetRef="UCard" />
    <bpmn:sequenceFlow id="F9" sourceRef="UCard" targetRef="UCardOK" />
    <bpmn:sequenceFlow id="F10" sourceRef="UCardOK" targetRef="URouteNeeded" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F11" sourceRef="UCardOK" targetRef="URetry" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F12" sourceRef="URouteNeeded" targetRef="URouteReq" name="Да">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Да</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F13" sourceRef="URouteNeeded" targetRef="UMerge" name="Нет">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">Нет</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="F14" sourceRef="URouteReq" targetRef="URoute" />
    <bpmn:sequenceFlow id="F15" sourceRef="URoute" targetRef="UMerge" />
    <bpmn:sequenceFlow id="F16" sourceRef="UMerge" targetRef="UEnd" />
  </bpmn:process>
  <bpmn:process id="Process_System" isExecutable="false">
    <bpmn:laneSet id="LaneSet_System">
      <bpmn:lane id="LaneAuto" name="Автоматическая обработка">
        <bpmn:flowNodeRef>SSearchStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SSearch</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SSearchEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SCardStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SCard</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SCardReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SCardEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SRouteStart</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SRoute</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SRouteReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SRouteEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="SSearchStart" name="Запрос поиска">
      <bpmn:outgoing>F17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SSearchStart_MessageDefinition" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="SSearch" name="Проверить запрос; определить точку; найти заведения">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SReply" name="Отправить список, пустой результат или ошибку">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="SSearchEnd" name="">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="SCardStart" name="Запрос карточки">
      <bpmn:outgoing>F20</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SCardStart_MessageDefinition" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="SCard" name="Проверить точку; подготовить карточку или объяснение">
      <bpmn:incoming>F20</bpmn:incoming>
      <bpmn:outgoing>F21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SCardReply" name="Отправить ответ на запрос карточки">
      <bpmn:incoming>F21</bpmn:incoming>
      <bpmn:outgoing>F22</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="SCardEnd" name="">
      <bpmn:incoming>F22</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="SRouteStart" name="Запрос маршрута">
      <bpmn:outgoing>F23</bpmn:outgoing>
      <bpmn:messageEventDefinition id="SRouteStart_MessageDefinition" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="SRoute" name="Проверить точки; получить маршрут или причину отказа">
      <bpmn:incoming>F23</bpmn:incoming>
      <bpmn:outgoing>F24</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="SRouteReply" name="Отправить маршрут или объяснение недоступности">
      <bpmn:incoming>F24</bpmn:incoming>
      <bpmn:outgoing>F25</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="SRouteEnd" name="">
      <bpmn:incoming>F25</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F17" sourceRef="SSearchStart" targetRef="SSearch" />
    <bpmn:sequenceFlow id="F18" sourceRef="SSearch" targetRef="SReply" />
    <bpmn:sequenceFlow id="F19" sourceRef="SReply" targetRef="SSearchEnd" />
    <bpmn:sequenceFlow id="F20" sourceRef="SCardStart" targetRef="SCard" />
    <bpmn:sequenceFlow id="F21" sourceRef="SCard" targetRef="SCardReply" />
    <bpmn:sequenceFlow id="F22" sourceRef="SCardReply" targetRef="SCardEnd" />
    <bpmn:sequenceFlow id="F23" sourceRef="SRouteStart" targetRef="SRoute" />
    <bpmn:sequenceFlow id="F24" sourceRef="SRoute" targetRef="SRouteReply" />
    <bpmn:sequenceFlow id="F25" sourceRef="SRouteReply" targetRef="SRouteEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Search">
    <bpmndi:BPMNPlane id="BPMNPlane_Search" bpmnElement="Collaboration_Search">
